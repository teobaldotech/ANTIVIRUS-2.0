   4. RENDERIZAÇÃO & CONTROLES DO SCANNER
========================================================= */
function updateQueueUI() {
    $("queueCount").textContent = String(fileQueue.length);
}

function updateMetricsUI() {
    const total = resultsData.length;
    const counts = { low: 0, medium: 0, high: 0, critical: 0 };
    let scoreSum = 0;

    for (const r of resultsData) {
        if (counts[r.riskLevel] !== undefined) counts[r.riskLevel]++;
        scoreSum += r.score;
    }

    $("totalFiles").textContent = String(total);
    $("lowCount").textContent = String(counts.low);
    $("mediumCount").textContent = String(counts.medium);
    $("highCount").textContent = String(counts.high);
    $("criticalCount").textContent = String(counts.critical);

    const avg = total ? Math.round(scoreSum / total) : 0;
    const avgEl = $("averageScore");
    avgEl.textContent = String(avg);
    avgEl.className = "metric-value " + (avg >= 75 ? "red" : avg >= 50 ? "orange" : avg >= 25 ? "yellow" : "green");

    const pct = n => total ? Math.round((n / total) * 100) : 0;
    ["low", "medium", "high", "critical"].forEach(lvl => {
        const p = pct(counts[lvl]);
        $(`${lvl}Percent`).textContent = `${p}%`;
        $(`${lvl}Fill`).style.width = `${p}%`;
    });
}

function renderResults() {
    const box = $("results");
    const list = sortReports(
        filterReports(resultsData, {
            query: $("searchInput").value,
            risk: $("riskFilter").value
        }),
        $("sortSelect").value
    );

    if (list.length === 0) {
        box.innerHTML = `<div class="empty">Nenhum laudo corresponde aos filtros atuais.</div>`;
        return;
    }

    box.innerHTML = list.map(item => `
        <article class="result ${escapeHTML(item.riskLevel)}">
            <div class="result-head">
                <div>
                    <div class="filename">
                        ${escapeHTML(item.name)}
                        <span class="source-tag">${escapeHTML(item.kind)}</span>
                    </div>
                    <div class="meta">${escapeHTML(formatDate(item.timestamp))} • ${escapeHTML(item.magic)}</div>
                </div>
                <div style="display:flex; align-items:center; gap:10px;">
                    <span class="badge ${escapeHTML(item.riskLevel)}">${escapeHTML(item.riskLabel)}</span>
                    <span class="score ${item.riskLevel === "critical" ? "red" : item.riskLevel === "high" ? "orange" : item.riskLevel === "medium" ? "yellow" : "green"}">${item.score}/100</span>
                </div>
            </div>

            <div class="result-grid">
                <div class="info"><small>Tamanho</small><strong>${escapeHTML(formatBytes(item.size))}</strong></div>
                <div class="info"><small>Entropia Shannon</small><strong>${item.entropy} bits/B</strong></div>
                <div class="info"><small>IOCs Extraídos</small><strong>${item.iocs.length}</strong></div>
                <div class="info"><small>SHA-512</small><div class="hash">${escapeHTML(item.hash)}</div></div>
            </div>

            <div class="reasons">
                <strong style="font-size:12px; color:var(--muted);">Diagnóstico Técnico:</strong>
                <ul>
                    ${item.reasons.map(r => `<li>${escapeHTML(r)}</li>`).join("")}
                </ul>
            </div>

            ${item.iocs.length ? `
                <div style="margin-top:10px;">
                    ${item.iocs.map(ioc => `<span class="ioc">${escapeHTML(ioc)}</span>`).join("")}
                </div>
            ` : ""}
        </article>
    `).join("");
}

function enqueueFiles(fileList, isSynthetic = false) {
    const cfg = getEngineConfig();
    let accepted = 0;

    for (const file of fileList) {
        const check = validateFileInput(file, cfg.sizeLimitMB);
        if (!check.valid) {
            addLog(`Rejeitado "${file?.name || "arquivo"}": ${check.error}`, "err");
            continue;
        }
        fileQueue.push({ file, isSynthetic });
        accepted++;
    }

    updateQueueUI();
    if (accepted > 0) {
        $("progressText").textContent = `${fileQueue.length} item(ns) pronto(s) na fila para análise.`;
        addLog(`${accepted} arquivo(s) validado(s) e enfileirado(s).`);
    }
}

async function processQueue() {
    if (isScanning) return;
    if (fileQueue.length === 0) {
        addLog("A fila de arquivos está vazia.", "warn");
        return;
    }

    isScanning = true;
    $("scanBtn").disabled = true;
    $("status").textContent = "● ANALISANDO...";
    const cfg = getEngineConfig();
    const total = fileQueue.length;

    for (let i = 0; i < total; i++) {
        const item = fileQueue[i];
        const pct = Math.round(((i + 1) / total) * 100);
        $("progressBar").style.width = `${pct}%`;
        $("progressText").textContent = `Analisando (${i + 1}/${total}): ${item.file.name}`;

        try {
            const buffer = await item.file.arrayBuffer();
            const report = await analyzeFileBuffer({
                name: item.file.name,
                size: item.file.size,
                buffer,
                isSynthetic: item.isSynthetic
            }, cfg);

            resultsData.unshift(report);
            addLog(`Concluído: ${report.name} [Score ${report.score} - ${report.riskLabel}]`);
        } catch (err) {
            addLog(`Erro ao ler "${item.file.name}": ${err.message}`, "err");
        }
    }

    fileQueue = [];
    updateQueueUI();
    saveState();
    updateMetricsUI();
    renderResults();

    $("progressText").textContent = `Análise concluída (${total} item(ns) processado(s)).`;
    $("status").textContent = "● SISTEMA PRONTO";
    $("scanBtn").disabled = false;
    isScanning = false;

    if (monetizationConfig.postScanInterstitial && total > 0) {
        requestInterstitialAd("conclusao_da_fila", false);
    }
}

