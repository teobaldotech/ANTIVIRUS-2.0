<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#06120c">
<title>NeonAV Secure PRO ULTRA 2.0</title>

<style>
:root{
    --bg:#030806;
    --panel:#07130d;
    --panel2:#0b1c13;
    --border:#123b27;
    --green:#00ff88;
    --green2:#00c96b;
    --text:#eafff2;
    --muted:#86a997;
    --red:#ff405f;
    --orange:#ffad32;
    --yellow:#ffe66d;
    --blue:#43b5ff;
    --purple:#b388ff;
    --shadow:0 0 25px rgba(0,255,136,.08);
}

*{ box-sizing:border-box; }

body{
    margin:0;
    font-family:Arial,Helvetica,sans-serif;
    background:
        radial-gradient(circle at 20% 10%,rgba(0,255,136,.08),transparent 25%),
        radial-gradient(circle at 80% 30%,rgba(0,180,100,.06),transparent 25%),
        var(--bg);
    color:var(--text);
    min-height:100vh;
    padding-bottom:76px;
}

button,input,select{ font:inherit; }
button{ cursor:pointer; }

.app{
    max-width:1500px;
    margin:auto;
    padding:20px;
}

/* Capa */
.cover{
    position:fixed;
    inset:0;
    background-color:#030806;
    background-image:
        radial-gradient(circle at 20% 10%,rgba(0,255,136,.08),transparent 25%),
        radial-gradient(circle at 80% 30%,rgba(0,180,100,.06),transparent 25%);
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:100;
    transition:opacity .4s ease-out, visibility .4s ease-out;
}
.cover.hidden{ opacity:0; visibility:hidden; pointer-events:none; }
.cover-content{ text-align:center; padding:20px; max-width:880px; }
.cover-logo{
    font-size:110px;
    color:var(--green);
    filter:drop-shadow(0 0 40px rgba(0,255,136,.45));
    animation:pulse 2.2s infinite;
}
@keyframes pulse{
    0%,100%{ transform:scale(1); }
    50%{ transform:scale(1.04); }
}
.cover-title{
    font-size:44px;
    margin:12px 0 8px;
    color:var(--green);
    text-shadow:0 0 22px rgba(0,255,136,.45);
}
.cover-subtitle{
    font-size:14px;
    color:var(--muted);
    margin-bottom:26px;
    letter-spacing:1.5px;
    text-transform:uppercase;
}
.cover-features{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    justify-content:center;
    margin-bottom:34px;
}
.cover-feature{
    padding:7px 16px;
    border:1px solid var(--border);
    border-radius:30px;
    font-size:12px;
    color:var(--muted);
    background:rgba(7,19,13,.6);
}
.cover-actions{ display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }
.cover-btn{
    padding:14px 26px;
    border-radius:12px;
    font-size:15px;
    font-weight:bold;
    transition:.2s;
    border:1px solid var(--border);
}
.cover-btn.primary{
    background:var(--green);
    color:#00170c;
    border-color:var(--green);
    box-shadow:0 0 25px rgba(0,255,136,.3);
}
.cover-btn.secondary{ background:#0a1d13; color:var(--text); }
.cover-btn:hover{ transform:translateY(-2px); border-color:var(--green); }

/* Header */
header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    padding:18px 20px;
    margin-bottom:18px;
    border:1px solid var(--border);
    border-radius:18px;
    background:linear-gradient(135deg,#06120b,#0b1c13);
    box-shadow:var(--shadow);
}
.brand{ display:flex; align-items:center; gap:15px; }
.logo{
    width:54px;
    height:54px;
    border-radius:15px;
    display:grid;
    place-items:center;
    font-size:26px;
    color:#00150b;
    background:var(--green);
    box-shadow:0 0 20px rgba(0,255,136,.3);
}
h1{ margin:0; font-size:23px; }
.version-tag{
    display:inline-block;
    font-size:11px;
    padding:3px 8px;
    border-radius:6px;
    background:rgba(0,255,136,.15);
    color:var(--green);
    border:1px solid var(--green);
    vertical-align:middle;
    margin-left:6px;
}
.subtitle{ margin:5px 0 0; color:var(--muted); font-size:13px; }
.status{
    padding:9px 15px;
    border:1px solid rgba(0,255,136,.3);
    border-radius:30px;
    color:var(--green);
    background:rgba(0,255,136,.06);
    font-weight:bold;
    font-size:12px;
}

/* Abas */
.nav-tabs{
    display:flex;
    gap:10px;
    margin-bottom:20px;
    border-bottom:1px solid var(--border);
    padding-bottom:14px;
    flex-wrap:wrap;
}
.tab-btn{
    background:var(--panel);
    border:1px solid var(--border);
    color:var(--muted);
    padding:11px 20px;
    border-radius:12px;
    font-weight:bold;
    font-size:13px;
    transition:all .2s;
    display:flex;
    align-items:center;
    gap:8px;
}
.tab-btn:hover{ color:var(--text); border-color:var(--green); }
.tab-btn.active{
    background:rgba(0,255,136,.1);
    color:var(--green);
    border-color:var(--green);
    box-shadow:0 0 15px rgba(0,255,136,.15);
}
.mode-pill{
    font-size:10px;
    padding:2px 6px;
    border-radius:4px;
    text-transform:uppercase;
}
.mode-real{ background:rgba(0,255,136,.18); color:var(--green); }
.mode-sim{ background:rgba(255,173,50,.2); color:var(--orange); }
.mode-qa{ background:rgba(179,136,255,.2); color:var(--purple); }

.tab-content{ display:none; }
.tab-content.active{ display:block; }

/* Banners de Transparência */
.context-banner{
    padding:12px 16px;
    border-radius:12px;
    margin-bottom:18px;
    font-size:13px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
}
.context-banner.real{
    background:rgba(0,255,136,.06);
    border:1px solid rgba(0,255,136,.35);
    color:#c8f7dc;
}
.context-banner.sim{
    background:rgba(255,173,50,.08);
    border:1px solid rgba(255,173,50,.4);
    color:#ffe2b3;
}
.context-banner.qa{
    background:rgba(179,136,255,.08);
    border:1px solid rgba(179,136,255,.4);
    color:#e6d9ff;
}

/* Dashboard */
.dashboard{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:12px;
    margin-bottom:20px;
}
.card{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:16px;
    padding:16px;
    box-shadow:var(--shadow);
}
.metric-title{ color:var(--muted); font-size:11px; text-transform:uppercase; }
.metric-value{ font-size:26px; font-weight:bold; margin-top:6px; }

.green{ color:var(--green); }
.orange{ color:var(--orange); }
.red{ color:var(--red); }
.blue{ color:var(--blue); }
.yellow{ color:var(--yellow); }
.purple{ color:var(--purple); }

.main{ display:grid; grid-template-columns:1.4fr .6fr; gap:20px; }

.panel{
    background:rgba(7,19,13,.94);
    border:1px solid var(--border);
    border-radius:18px;
    padding:20px;
    box-shadow:var(--shadow);
    margin-bottom:20px;
}
.panel h2{ margin-top:0; font-size:17px; }

.dropzone{
    min-height:165px;
    border:2px dashed #195b3b;
    border-radius:16px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:20px;
    transition:.2s;
    background:rgba(0,255,136,.025);
}
.dropzone.drag{
    border-color:var(--green);
    background:rgba(0,255,136,.08);
    transform:scale(1.01);
}
.drop-icon{ font-size:36px; margin-bottom:6px; }
.dropzone strong{ color:var(--green); }

.actions{ display:flex; flex-wrap:wrap; gap:9px; margin-top:15px; }

.btn{
    border:1px solid var(--border);
    background:#0a1d13;
    color:var(--text);
    padding:10px 14px;
    border-radius:10px;
    transition:.2s;
    font-size:13px;
}
.btn:hover{ border-color:var(--green); box-shadow:0 0 15px rgba(0,255,136,.12); }
.btn:disabled{ opacity:.45; cursor:not-allowed; }
.btn.primary{ background:var(--green); color:#00170c; border-color:var(--green); font-weight:bold; }
.btn.danger{ color:#fff; background:#3a1019; border-color:#6c1b2d; }
.btn.warning{ color:#111; background:var(--orange); border-color:var(--orange); font-weight:bold; }
.btn.blue{ color:#06131d; background:var(--blue); border-color:var(--blue); font-weight:bold; }
.btn.purple{ color:#120624; background:var(--purple); border-color:var(--purple); font-weight:bold; }

input,select{
    width:100%;
    padding:11px;
    color:var(--text);
    background:#04100a;
    border:1px solid var(--border);
    border-radius:9px;
    outline:none;
}
input:focus,select:focus{ border-color:var(--green); box-shadow:0 0 10px rgba(0,255,136,.1); }

.validation-msg{
    font-size:12px;
    margin-top:6px;
    min-height:16px;
    color:var(--red);
}

.progress{
    height:11px;
    background:#020805;
    border-radius:20px;
    overflow:hidden;
    border:1px solid var(--border);
    margin-top:15px;
}
.progress-bar{
    height:100%;
    width:0%;
    background:linear-gradient(90deg,var(--green2),var(--green));
    transition:.2s;
}
.progress-text{ font-size:12px; color:var(--muted); margin-top:7px; }

.filters{
    display:grid;
    grid-template-columns:1.5fr 1fr 1fr;
    gap:10px;
    margin-bottom:15px;
}

.results{ display:flex; flex-direction:column; gap:12px; }

.result{
    background:#06110b;
    border:1px solid var(--border);
    border-left:4px solid var(--green);
    border-radius:14px;
    padding:16px;
}
.result.medium{ border-left-color:var(--yellow); }
.result.high{ border-left-color:var(--orange); }
.result.critical{ border-left-color:var(--red); }

.result-head{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:12px;
}
.filename{ font-size:16px; font-weight:bold; word-break:break-word; }
.meta{ color:var(--muted); font-size:12px; margin-top:5px; }

.badge{
    padding:5px 10px;
    border-radius:20px;
    font-size:11px;
    font-weight:bold;
    white-space:nowrap;
}
.badge.low{ color:#00170c; background:var(--green); }
.badge.medium{ color:#191300; background:var(--yellow); }
.badge.high{ color:#211000; background:var(--orange); }
.badge.critical{ color:#fff; background:var(--red); }

.source-tag{
    display:inline-block;
    font-size:10px;
    padding:2px 7px;
    border-radius:5px;
    margin-left:6px;
    background:#0d261a;
    border:1px solid var(--border);
    color:var(--green);
    vertical-align:middle;
}

.score{ font-size:24px; font-weight:bold; }

.result-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
    margin-top:14px;
}
.info{
    padding:10px;
    background:#08170f;
    border-radius:9px;
    border:1px solid #0e2c1c;
}
.info small{ display:block; color:var(--muted); margin-bottom:5px; font-size:11px; }
.hash{ word-break:break-all; font-family:monospace; font-size:11px; }

.reasons{ margin-top:14px; }
.reasons ul{ margin-bottom:0; padding-left:20px; }
.reasons li{ margin:5px 0; color:#c8e9d5; font-size:13px; }

.ioc{
    display:inline-block;
    padding:4px 8px;
    margin:3px;
    border-radius:6px;
    font-family:monospace;
    font-size:11px;
    background:#241019;
    border:1px solid #60213a;
    color:#ff9bb0;
    word-break:break-all;
}

.log{
    max-height:280px;
    overflow:auto;
    background:#020704;
    border:1px solid var(--border);
    border-radius:10px;
    padding:10px;
    font-family:monospace;
    font-size:11px;
}
.log-line{ padding:4px 0; border-bottom:1px solid #082014; }
.log-time{ color:var(--green); }
.log-warn{ color:var(--orange); }
.log-err{ color:var(--red); }

.empty{ text-align:center; color:var(--muted); padding:32px 10px; }

.stats-bar{ margin-top:10px; }
.stats-label{ display:flex; justify-content:space-between; font-size:11px; color:var(--muted); margin-bottom:4px; }
.stats-track{ height:8px; background:#020805; border-radius:10px; overflow:hidden; }
.stats-fill{ height:100%; background:var(--green); transition:width .3s; }

.toggle{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    padding:10px 4px;
    border-bottom:1px solid #0b2819;
    font-size:13px;
}
.toggle input{ width:auto; accent-color:var(--green); }

/* Monetização (Web + Ponte Android AdMob) */
.monetization-panel{
    border-color:rgba(67,181,255,.38);
}
.ad-slot-card{
    background:#05110b;
    border:1px dashed #195b3b;
    border-radius:12px;
    padding:12px;
    margin-top:10px;
}
.ad-slot-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:8px;
    font-size:11px;
    color:var(--muted);
    margin-bottom:8px;
}
.ad-pill{
    padding:2px 7px;
    border-radius:5px;
    font-size:10px;
    font-weight:bold;
    background:rgba(67,181,255,.16);
    color:var(--blue);
    border:1px solid rgba(67,181,255,.4);
}
.ad-pill.ready{
    background:rgba(0,255,136,.16);
    color:var(--green);
    border-color:rgba(0,255,136,.45);
}
.ad-preview-box{
    min-height:56px;
    border-radius:9px;
    background:linear-gradient(135deg,#071810,#0c2217);
    border:1px solid #123b27;
    padding:10px 12px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    font-size:12px;
}
.ad-grid-2{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    margin-top:10px;
}
.ad-input-group{
    margin-top:10px;
}
.ad-input-group label{
    display:block;
    font-size:11px;
    color:var(--muted);
    margin-bottom:4px;
}
.ad-status-bar{
    margin-top:10px;
    padding:8px 10px;
    border-radius:8px;
    font-size:11px;
    background:#04100a;
    border:1px solid var(--border);
    color:var(--muted);
}

/* Banner Rodapé Fixo Não Intrusivo */
.sticky-banner-bar{
    position:fixed;
    left:0;
    right:0;
    bottom:0;
    z-index:40;
    background:rgba(4,13,9,.96);
    border-top:1px solid var(--border);
    padding:8px 16px;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:14px;
    backdrop-filter:blur(6px);
}
.sticky-banner-bar.hidden{ display:none; }
.sticky-ad-badge{
    font-size:10px;
    font-weight:bold;
    padding:2px 6px;
    border-radius:4px;
    background:rgba(255,230,109,.15);
    color:var(--yellow);
    border:1px solid rgba(255,230,109,.4);
}

/* Firewall / IPS Simulado */
.firewall-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin-bottom:20px;
}
.fw-card{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:16px;
    padding:18px;
    position:relative;
    overflow:hidden;
}
.fw-card::before{
    content:'';
    position:absolute;
    top:0; left:0;
    width:4px; height:100%;
}
.fw-card.ddos::before{ background:var(--blue); }
.fw-card.xss::before{ background:var(--yellow); }
.fw-card.sql::before{ background:var(--orange); }
.fw-card.brute::before{ background:var(--red); }
.fw-title{ font-size:12px; color:var(--muted); text-transform:uppercase; }
.fw-count{ font-size:30px; font-weight:bold; margin-top:8px; }

.attack-feed{
    max-height:420px;
    overflow-y:auto;
    display:flex;
    flex-direction:column;
    gap:10px;
}
.attack-item{
    background:#05100a;
    border:1px solid var(--border);
    border-radius:12px;
    padding:14px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
}
.attack-type-badge{
    display:inline-block;
    padding:3px 8px;
    border-radius:6px;
    font-size:10px;
    font-weight:bold;
    text-transform:uppercase;
}
.attack-type-badge.ddos{ background:rgba(67,181,255,.2); color:var(--blue); border:1px solid var(--blue); }
.attack-type-badge.xss{ background:rgba(255,230,109,.2); color:var(--yellow); border:1px solid var(--yellow); }
.attack-type-badge.sql{ background:rgba(255,173,50,.2); color:var(--orange); border:1px solid var(--orange); }
.attack-type-badge.brute{ background:rgba(255,64,95,.2); color:var(--red); border:1px solid var(--red); }
.attack-ip{ font-family:monospace; font-size:13px; color:var(--text); font-weight:bold; margin-top:4px; }
.attack-details{ font-size:12px; color:var(--muted); }
.blocked-badge{
    background:rgba(0,255,136,.15);
    color:var(--green);
    border:1px solid var(--green);
    padding:5px 11px;
    border-radius:20px;
    font-size:11px;
    font-weight:bold;
    white-space:nowrap;
}
.bypassed-badge{
    background:rgba(255,64,95,.15);
    color:var(--red);
    border:1px solid var(--red);
    padding:5px 11px;
    border-radius:20px;
    font-size:11px;
    font-weight:bold;
    white-space:nowrap;
}

/* Testes Automatizados */
.test-summary{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
    margin-bottom:18px;
}
.test-case{
    background:#05100a;
    border:1px solid var(--border);
    border-radius:12px;
    padding:14px;
    margin-bottom:10px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
}
.test-case.pass{ border-left:4px solid var(--green); }
.test-case.fail{ border-left:4px solid var(--red); }

.footer{
    text-align:center;
    color:#527060;
    font-size:11px;
    margin-top:25px;
    padding:15px;
}

/* Modal */
.modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.78);
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
    z-index:50;
}
.modal.show{ display:flex; }
.modal-box{
    width:min(760px,100%);
    max-height:90vh;
    overflow:auto;
    background:#07130d;
    border:1px solid var(--green);
    border-radius:18px;
    padding:22px;
    box-shadow:0 0 40px rgba(0,255,136,.15);
}
.close{
    float:right;
    border:0;
    background:transparent;
    color:#fff;
    font-size:25px;
}
.test-file{
    padding:12px;
    border:1px solid var(--border);
    border-radius:10px;
    margin:8px 0;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
}

@media(max-width:1100px){
    .dashboard,.firewall-grid,.test-summary{ grid-template-columns:repeat(2,1fr); }
    .main{ grid-template-columns:1fr; }
}
@media(max-width:700px){
    .app{ padding:10px; }
    header{ flex-direction:column; align-items:flex-start; }
    .dashboard,.firewall-grid,.test-summary,.ad-grid-2{ grid-template-columns:1fr; }
    .filters{ grid-template-columns:1fr; }
    .result-grid{ grid-template-columns:repeat(2,1fr); }
    .result-head{ flex-direction:column; }
    .cover-title{ font-size:32px; }
}
</style>
</head>

<body>

<!-- Capa -->
<div class="cover" id="coverScreen">
    <div class="cover-content">
        <div class="cover-logo">🛡️</div>
        <h2 class="cover-title">NeonAV Secure PRO ULTRA 2.0</h2>
        <div class="cover-subtitle">Análise Estática Local Real • Simulador IPS Educativo • 12 Testes Automatizados</div>
        
        <div class="cover-features">
            <span class="cover-feature">SHA-512 WebCrypto</span>
            <span class="cover-feature">Entropia de Shannon</span>
            <span class="cover-feature">Validação Estrita de Entradas</span>
            <span class="cover-feature">Separação Real vs. Simulação</span>
            <span class="cover-feature">Suíte QA (12 Testes)</span>
            <span class="cover-feature">AdMob Ready + WebView Bridge</span>
        </div>

        <div class="cover-actions">
            <button class="cover-btn primary" id="coverStartBtn">🚀 Acessar Painel 2.0</button>
            <button class="cover-btn secondary" id="coverTestBtn">🧪 Abrir Amostras Sintéticas</button>
            <button class="cover-btn secondary" id="coverQaBtn">⚙️ Executar 12 Testes Automatizados</button>
        </div>
    </div>
</div>

<div class="app">

<header>
    <div class="brand">
        <div class="logo">🛡️</div>
