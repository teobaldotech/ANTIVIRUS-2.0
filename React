const STORAGE_KEY = "neonav-pro-ultra-v2-results";
let fileQueue = [];
let resultsData = [];
let isScanning = false;

function addLog(message, type = "info") {
    const logBox = $("log");
    const line = document.createElement("div");
    line.className = "log-line";
    const time = new Date().toLocaleTimeString("pt-BR");
    const cls = type === "warn" ? "log-warn" : type === "err" ? "log-err" : "log-time";
    line.innerHTML = `<span class="${cls}">[${escapeHTML(time)}]</span> ${escapeHTML(message)}`;
    logBox.prepend(line);
}

function saveState() {
    try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(resultsData.slice(0, 100)));
    } catch {
        addLog("Aviso: limite de armazenamento local atingido.", "warn");
    }
}

function loadState() {
    try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) {
            resultsData = parsed.filter(item => item && typeof item.id === "string" && typeof item.score === "number");
        }
    } catch {
        localStorage.removeItem(STORAGE_KEY);
    }
}

function getEngineConfig() {
    return {
        urls: $("cfgUrls").checked,
        entropy: $("cfgEntropy").checked,
        extension: $("cfgExtension").checked,
        ioc: $("cfgIoc").checked,
