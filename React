        : "Ambiente: Navegador Web (Simulação Segura de Slots)";

    const badge = $("adRuntimeBadge");
    badge.textContent = isNative ? "ANDROID ADMOB" : validation.productionReady ? "IDs CONFIGURADOS" : "WEB FALLBACK";
    badge.classList.toggle("ready", isNative || validation.productionReady);

    $("cfgStickyBanner").checked = monetizationConfig.stickyBannerEnabled;
    $("cfgPostScanAd").checked = monetizationConfig.postScanInterstitial;
    $("admobAppIdInput").value = monetizationConfig.appId;
    $("admobBannerIdInput").value = monetizationConfig.bannerUnitId;
    $("admobInterstitialIdInput").value = monetizationConfig.interstitialUnitId;
    $("admobRewardedIdInput").value = monetizationConfig.rewardedUnitId;
    $("admobNativeIdInput").value = monetizationConfig.nativeUnitId;

    const unitLabel = monetizationConfig.nativeUnitId || monetizationConfig.bannerUnitId
        ? `Unit Ativa: ${monetizationConfig.nativeUnitId || monetizationConfig.bannerUnitId} • Impressões: ${monetizationConfig.impressions}`
        : `Modo demonstração local • Impressões: ${monetizationConfig.impressions} • Recompensas: ${monetizationConfig.rewardsEarned}`;
    $("bannerAdUnitText").textContent = unitLabel;

    $("adValidationStatus").textContent = validation.productionReady
        ? `Status: Pronto para ponte AdMob (${validation.configuredCount} unidade(s) validada(s)).`
        : "Status: Modo Demo Local (preencha App ID + Unit IDs para produção).";

    const stickyBar = $("stickyBannerBar");
    stickyBar.classList.toggle("hidden", !monetizationConfig.stickyBannerEnabled);
    document.body.style.paddingBottom = monetizationConfig.stickyBannerEnabled ? "76px" : "20px";
    $("stickyBannerText").textContent = monetizationConfig.bannerUnitId
        ? `NeonAV Pro • Banner AdMob (${monetizationConfig.bannerUnitId})`
        : "NeonAV Secure PRO ULTRA 2.0 • Slot Banner Adaptativo (320x50)";
}

function refreshBannerSlot() {
    monetizationConfig.impressions++;
    if (hasAndroidAdBridge()) {
        if (typeof window.NeonAVBridge.refreshBanner === "function") {
            window.NeonAVBridge.refreshBanner(monetizationConfig.bannerUnitId);
        }
        if (typeof window.NeonAVBridge.renderNativeAd === "function" && monetizationConfig.nativeUnitId) {
            window.NeonAVBridge.renderNativeAd(monetizationConfig.nativeUnitId);
        }
    }
    saveMonetizationConfig();
    renderMonetizationUI();
    addLog(`Slots Banner/Native atualizados (${monetizationConfig.impressions} impressões).`);
}

function requestInterstitialAd(reason = "manual", forceManual = true) {
    const now = Date.now();
    if (!canTriggerInterstitial(now, monetizationConfig.lastInterstitialAt, forceManual)) {
        addLog(`Interstitial ignorado pelo cooldown de 90s (${reason}).`);
        return false;
    }

    monetizationConfig.lastInterstitialAt = now;
    monetizationConfig.impressions++;
    saveMonetizationConfig();
    renderMonetizationUI();

    if (hasAndroidAdBridge()) {
        window.NeonAVBridge.showInterstitial(monetizationConfig.interstitialUnitId, reason);
        addLog(`Interstitial nativo solicitado (${reason}).`);
        return true;
    }

    addLog(`[DEMO WEB] Interstitial exibido (${reason}).`);
    return true;
}

function requestRewardedAd(onRewardGranted) {
    if (hasAndroidAdBridge()) {
        window.NeonAVBridge.showRewarded(monetizationConfig.rewardedUnitId, "export_bonus");
        addLog("Rewarded nativo solicitado ao Android WebView.");
        return;
    }
    monetizationConfig.rewardsEarned++;
    saveMonetizationConfig();
    renderMonetizationUI();
    addLog("[DEMO WEB] Recompensa concedida: exportação prioritária habilitada.");
    if (typeof onRewardGranted === "function") onRewardGranted();
}

window.onNativeRewardEarned = function (rewardType = "bonus") {
    monetizationConfig.rewardsEarned++;
    saveMonetizationConfig();
    renderMonetizationUI();
    addLog(`Recompensa nativa confirmada (${rewardType}). Total: ${monetizationConfig.rewardsEarned}.`);
};

$("refreshBannerBtn").addEventListener("click", refreshBannerSlot);
$("triggerInterstitialBtn").addEventListener("click", () => requestInterstitialAd("teste_manual", true));
$("triggerRewardedBtn").addEventListener("click", () => requestRewardedAd());

$("cfgStickyBanner").addEventListener("change", e => {
    monetizationConfig.stickyBannerEnabled = Boolean(e.target.checked);
    saveMonetizationConfig();
    renderMonetizationUI();
});

$("closeStickyBannerBtn").addEventListener("click", () => {
    monetizationConfig.stickyBannerEnabled = false;
    saveMonetizationConfig();
    renderMonetizationUI();
});

$("cfgPostScanAd").addEventListener("change", e => {
    monetizationConfig.postScanInterstitial = Boolean(e.target.checked);
    saveMonetizationConfig();
    addLog(`Interstitial automático após fila ${monetizationConfig.postScanInterstitial ? "ativado" : "desativado"}.`);
});

$("saveMonetizationBtn").addEventListener("click", () => {
    const candidate = {
        appId: $("admobAppIdInput").value.trim(),
        bannerUnitId: $("admobBannerIdInput").value.trim(),
        interstitialUnitId: $("admobInterstitialIdInput").value.trim(),
        rewardedUnitId: $("admobRewardedIdInput").value.trim(),
        nativeUnitId: $("admobNativeIdInput").value.trim()
    };

    const check = validateAdMobIds(candidate);
    if (!check.valid) {
        $("adValidationStatus").textContent = `Erro: ${check.error}`;
        addLog(`Falha ao salvar AdMob IDs: ${check.error}`, "err");
        return;
    }

    Object.assign(monetizationConfig, candidate);
    saveMonetizationConfig();
    renderMonetizationUI();
    addLog(`Configurações AdMob validadas e salvas (${check.configuredCount} unidade(s)).`);
});

$("resetMonetizationBtn").addEventListener("click", () => {
    monetizationConfig = {
        appId: "",
        bannerUnitId: "",
        interstitialUnitId: "",
        rewardedUnitId: "",
        nativeUnitId: "",
        stickyBannerEnabled: true,
        postScanInterstitial: false,
        lastInterstitialAt: 0,
        impressions: 0,
        rewardsEarned: 0
    };
    localStorage.removeItem(MONETIZATION_STORAGE_KEY);
    renderMonetizationUI();
    addLog("Dados e IDs de monetização resetados.");
});

/* =========================================================
   8. SIMULADOR DE FIREWALL / IPS (SEPARADO DO SCANNER REAL)
========================================================= */
const SIM_ATTACK_TEMPLATES = {
    ddos: { label: "DDoS SYN/HTTP Flood", details: "Rajada sintética de 38.000 req/s na porta 443" },
    xss: { label: "XSS Refletido", details: "Payload <script>alert(1)<\/script> detectado em query string" },
    sql: { label: "SQL Injection", details: "Assinatura ' OR 1=1 -- UNION SELECT bloqueada no parser" },
    brute: { label: "Credential Stuffing", details: "95 tentativas de autenticação falhas em 30 segundos" }
};

let simStats = { ddos: 0, xss: 0, sql: 0, brute: 0 };
let simEvents = [];

function randomTestIP() {
    const lastOctet = Math.floor(Math.random() * 250) + 1;
    return `203.0.113.${lastOctet}`;
}

function triggerSimulatedAttack(type) {
    const tpl = SIM_ATTACK_TEMPLATES[type] || SIM_ATTACK_TEMPLATES.ddos;
    const active = $("ipsToggle").checked;

    if (active) {
        simStats[type]++;
    }

    simEvents.unshift({
        id: uuid(),
        type,
        title: tpl.label,
        details: tpl.details,
        ip: randomTestIP(),
        blocked: active,
        timestamp: Date.now()
    });
    simEvents = simEvents.slice(0, 40);
    renderFirewallSim();
}

function renderFirewallSim() {
    $("countDdos").textContent = String(simStats.ddos);
    $("countXss").textContent = String(simStats.xss);
    $("countSql").textContent = String(simStats.sql);
    $("countBrute").textContent = String(simStats.brute);

    const feed = $("attackFeed");
    if (simEvents.length === 0) {
        feed.innerHTML = `<div class="empty">Nenhum evento simulado registrado. Utilize os botões acima para testar regras WAF/IPS.</div>`;
        return;
    }

    feed.innerHTML = simEvents.map(ev => `
        <div class="attack-item">
            <div>
                <span class="attack-type-badge ${escapeHTML(ev.type)}">[SIMULAÇÃO] ${escapeHTML(ev.title)}</span>
                <div class="attack-ip">Origem RFC-5737: ${escapeHTML(ev.ip)}</div>
                <div class="attack-details">${escapeHTML(ev.details)} • ${escapeHTML(formatDate(ev.timestamp))}</div>
            </div>
            <div>
                ${ev.blocked
                    ? `<span class="blocked-badge">✔ MITIGADO</span>`
                    : `<span class="bypassed-badge">⚠ IPS DESATIVADO</span>`
                }
            </div>
        </div>
    `).join("");
}

/* =========================================================
   9. SUÍTE DE TESTES AUTOMATIZADOS (12 ASSERÇÕES)
========================================================= */
async function runAutomatedTestSuite() {
    const t0 = performance.now();
    const cases = [];

    async function assertCase(name, fn) {
        try {
            await fn();
            cases.push({ name, passed: true, detail: "Asserção validada com sucesso." });
        } catch (err) {
            cases.push({ name, passed: false, detail: err.message });
        }
    }

    await assertCase("1. Sanitização XSS (escapeHTML)", () => {
        const out = escapeHTML(`<img src=x onerror="alert('xss')">`);
        if (out.includes("<") || out.includes(">") || out.includes('"')) {
            throw new Error("Caracteres perigosos não foram escapados.");
        }
    });

    await assertCase("2. Validação de Entrada de URL (Bloqueio de Esquema Inválido)", () => {
        const bad = validateURLInput("javascript:alert(1)");
        if (bad.valid) throw new Error("Esquema javascript: deveria ser bloqueado.");
        const good = validateURLInput("https://example.com/login");
        if (!good.valid) throw new Error("URL HTTPS válida foi rejeitada.");
    });

    await assertCase("3. Validação de Limite de Arquivo", () => {
        const oversized = validateFileInput({ name: "grande.bin", size: 20 * 1024 * 1024 }, 10);
        if (oversized.valid) throw new Error("Arquivo acima do limite deveria falhar.");
    });

    await assertCase("4. Cálculo Real de Entropia de Shannon", () => {
        const uniform = new Uint8Array(256);
        for (let i = 0; i < 256; i++) uniform[i] = i;
        const h = calculateShannonEntropy(uniform);
        if (Math.abs(h - 8.0) > 0.01) throw new Error(`Esperado ~8.0, obtido ${h}`);
    });

    await assertCase("5. Integridade Criptográfica SHA-512 (WebCrypto)", async () => {
        const buf = new TextEncoder().encode("NeonAV").buffer;
        const digest = await computeSHA512(buf);
        if (digest.length !== 128) throw new Error(`Tamanho de SHA-512 inválido: ${digest.length}`);
    });

    await assertCase("6. Detecção Heurística em Amostra Sintética Suspeita", async () => {
        const buf = new TextEncoder().encode("powershell.exe -EncodedCommand AAA; eval(atob('x'))").buffer;
        const res = await analyzeFileBuffer({ name: "teste.ps1", size: buf.byteLength, buffer: buf, isSynthetic: true }, {
            urls: true, entropy: true, extension: true, ioc: true
        });
        if (res.score < 50) throw new Error(`Score esperado >= 50, obtido ${res.score}`);
    });

    await assertCase("7. Classificação Limpa em Arquivo Inofensivo", async () => {
        const buf = new TextEncoder().encode("Apenas texto simples de documentação.").buffer;
        const res = await analyzeFileBuffer({ name: "notas.txt", size: buf.byteLength, buffer: buf, isSynthetic: true }, {
            urls: true, entropy: true, extension: true, ioc: true
        });
        if (res.riskLevel !== "low") throw new Error(`Esperado risco 'low', obtido '${res.riskLevel}'`);
    });

    await assertCase("8. Classificação de Risco (classifyRisk - Faixas e Limites)", () => {
        if (classifyRisk(0).level !== "low" || classifyRisk(24).level !== "low") {
            throw new Error("Faixa baixa (0-24) falhou.");
        }
        if (classifyRisk(25).level !== "medium" || classifyRisk(49).level !== "medium") {
            throw new Error("Faixa média (25-49) falhou.");
        }
        if (classifyRisk(50).level !== "high" || classifyRisk(74).level !== "high") {
            throw new Error("Faixa alta (50-74) falhou.");
        }
        if (classifyRisk(75).level !== "critical" || classifyRisk(100).level !== "critical") {
            throw new Error("Faixa crítica (75-100) falhou.");
        }
    });

    await assertCase("9. Ordenação por Score e Tamanho (sortReports)", () => {
        const sample = [
            { name: "a.txt", score: 15, size: 5000, timestamp: 1 },
            { name: "b.exe", score: 88, size: 200, timestamp: 2 },
            { name: "c.js", score: 42, size: 12000, timestamp: 3 }
        ];
        const byScore = sortReports(sample, "score");
        if (byScore[0].name !== "b.exe" || byScore[2].name !== "a.txt") {
            throw new Error("Ordenação por score incorreta.");
        }
        const bySize = sortReports(sample, "size");
        if (bySize[0].name !== "c.js" || bySize[2].name !== "b.exe") {
            throw new Error("Ordenação por tamanho incorreta.");
        }
    });

    await assertCase("10. Filtros de Risco e Busca por IOC/Hash (filterReports)", () => {
        const sample = [
            { name: "dropper.ps1", hash: "abc123", riskLevel: "critical", iocs: ["203.0.113.10"] },
            { name: "readme.md", hash: "def456", riskLevel: "low", iocs: [] }
        ];
        const onlyCritical = filterReports(sample, { risk: "critical", query: "" });
        if (onlyCritical.length !== 1 || onlyCritical[0].name !== "dropper.ps1") {
            throw new Error("Filtro por nível de risco falhou.");
        }
        const byIoc = filterReports(sample, { risk: "all", query: "203.0.113.10" });
        if (byIoc.length !== 1) {
            throw new Error("Busca textual por IOC falhou.");
        }
    });

    await assertCase("11. Geração e Integridade de Exportação JSON e CSV", () => {
        const sample = [{
            name: 'payload,"especial".js',
            kind: "AMOSTRA SINTÉTICA",
            riskLabel: "ALTO",
            score: 65,
            size: 1024,
            entropy: 5.42,
            hash: "0".repeat(128),
            timestamp: 1700000000000
        }];
        const jsonStr = buildJSONExport(sample);
        const parsed = JSON.parse(jsonStr);
        if (!Array.isArray(parsed) || parsed[0].score !== 65) {
            throw new Error("Exportação JSON inválida.");
        }
        const csvStr = buildCSVExport(sample);
        const lines = csvStr.split("\n");
        if (lines.length !== 2 || !lines[1].includes('"payload,""especial"".js"')) {
            throw new Error("Escape de aspas no CSV falhou.");
        }
    });

    await assertCase("12. Validação AdMob IDs & Cooldown de Interstitial", () => {
        const invalid = validateAdMobIds({ appId: "id-invalido" });
        if (invalid.valid) throw new Error("App ID malformado deveria ser rejeitado.");

        const valid = validateAdMobIds({
            appId: "ca-app-pub-3940256099942544~3347511713",
            bannerUnitId: "ca-app-pub-3940256099942544/6300978111"
        });
        if (!valid.valid || !valid.productionReady) {
            throw new Error("IDs AdMob válidos deveriam ser aceitos.");
        }

        const now = 1_000_000;
        if (canTriggerInterstitial(now, now - 10_000, false)) {
            throw new Error("Cooldown de 90s deveria bloquear disparo automático recente.");
        }
        if (!canTriggerInterstitial(now, now - 95_000, false)) {
            throw new Error("Interstitial deveria ser liberado após 90s.");
        }
    });

    const elapsed = (performance.now() - t0).toFixed(1);
    const passed = cases.filter(c => c.passed).length;
    const failed = cases.length - passed;

    $("qaTotal").textContent = String(cases.length);
    $("qaPassed").textContent = String(passed);
    $("qaFailed").textContent = String(failed);
    $("qaTime").textContent = `${elapsed} ms`;

    $("qaResults").innerHTML = cases.map(c => `
        <div class="test-case ${c.passed ? "pass" : "fail"}">
            <div>
                <strong>${escapeHTML(c.name)}</strong>
                <div class="meta">${escapeHTML(c.detail)}</div>
            </div>
            <span class="badge ${c.passed ? "low" : "critical"}">${c.passed ? "PASS" : "FAIL"}</span>
        </div>
    `).join("");

    addLog(`Suíte QA (12 testes) executada: ${passed}/${cases.length} aprovados em ${elapsed} ms.`);
}

/* =========================================================
   10. EVENT LISTENERS & INICIALIZAÇÃO
========================================================= */
function switchTab(tabId) {
    document.querySelectorAll(".tab-btn").forEach(b => b.classList.toggle("active", b.dataset.tab === tabId));
    document.querySelectorAll(".tab-content").forEach(c => c.classList.toggle("active", c.id === tabId));
}

document.querySelectorAll(".tab-btn").forEach(btn => {
    btn.addEventListener("click", () => switchTab(btn.dataset.tab));
});

$("coverStartBtn").addEventListener("click", () => $("coverScreen").classList.add("hidden"));
$("coverTestBtn").addEventListener("click", () => {
    $("coverScreen").classList.add("hidden");
    $("testModal").classList.add("show");
});
$("coverQaBtn").addEventListener("click", () => {
    $("coverScreen").classList.add("hidden");
    switchTab("qaTab");
    runAutomatedTestSuite();
});

$("selectBtn").addEventListener("click", () => $("fileInput").click());
$("fileInput").addEventListener("change", e => {
    if (e.target.files?.length) enqueueFiles(e.target.files, false);
    e.target.value = "";
});

const dropzone = $("dropzone");
dropzone.addEventListener("dragover", e => { e.preventDefault(); dropzone.classList.add("drag"); });
dropzone.addEventListener("dragleave", () => dropzone.classList.remove("drag"));
dropzone.addEventListener("drop", e => {
    e.preventDefault();
    dropzone.classList.remove("drag");
    if (e.dataTransfer?.files?.length) enqueueFiles(e.dataTransfer.files, false);
});

$("scanBtn").addEventListener("click", processQueue);

$("scanUrlBtn").addEventListener("click", async () => {
    const msgEl = $("urlValidationMsg");
    msgEl.textContent = "";
    const check = validateURLInput($("urlInput").value);
    if (!check.valid) {
        msgEl.textContent = check.error;
        addLog(`URL rejeitada na validação: ${check.error}`, "warn");
        return;
    }

    const report = await analyzeURLStatic(check.url);
    resultsData.unshift(report);
    saveState();
    updateMetricsUI();
    renderResults();
    $("urlInput").value = "";
    addLog(`URL analisada estaticamente: ${report.name} [${report.riskLabel}]`);
});

$("testBtn").addEventListener("click", () => $("testModal").classList.add("show"));
$("closeModal").addEventListener("click", () => $("testModal").classList.remove("show"));
$("testModal").addEventListener("click", e => {
    if (e.target === $("testModal")) $("testModal").classList.remove("show");
});
document.addEventListener("keydown", e => {
    if (e.key === "Escape") $("testModal").classList.remove("show");
});

$("clearBtn").addEventListener("click", () => {
    fileQueue = [];
    resultsData = [];
    localStorage.removeItem(STORAGE_KEY);
    updateQueueUI();
    updateMetricsUI();
    renderResults();
    $("progressBar").style.width = "0%";
    $("progressText").textContent = "Histórico e fila limpos.";
    addLog("Histórico de laudos e fila removidos.");
});

$("searchInput").addEventListener("input", renderResults);
$("riskFilter").addEventListener("change", renderResults);
$("sortSelect").addEventListener("change", renderResults);

$("simulateAttackBtn").addEventListener("click", () => {
    const keys = Object.keys(SIM_ATTACK_TEMPLATES);
    triggerSimulatedAttack(keys[Math.floor(Math.random() * keys.length)]);
});

$("simTriggerGroup").addEventListener("click", e => {
    const btn = e.target.closest("[data-attack]");
    if (btn) triggerSimulatedAttack(btn.dataset.attack);
});

$("clearAttacksBtn").addEventListener("click", () => {
    simStats = { ddos: 0, xss: 0, sql: 0, brute: 0 };
    simEvents = [];
    renderFirewallSim();
});

$("runTestsBtn").addEventListener("click", runAutomatedTestSuite);

// Boot
loadState();
loadMonetizationConfig();
updateQueueUI();
updateMetricsUI();
renderResults();
renderFirewallSim();
renderMonetizationUI();
addLog("NeonAV Secure PRO ULTRA 2.0 inicializado com 12 testes QA e AdMob Ready.");
</script>
