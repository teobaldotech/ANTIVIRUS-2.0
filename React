<script>
"use strict";

/* =========================================================
   1. UTILITÁRIOS SEGUROS & VALIDAÇÃO DE ENTRADAS
========================================================= */
const $ = id => document.getElementById(id);

function escapeHTML(value) {
    return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}

function uuid() {
    if (window.crypto && typeof window.crypto.randomUUID === "function") {
        return window.crypto.randomUUID();
    }
    const arr = new Uint8Array(16);
    if (window.crypto && window.crypto.getRandomValues) {
        window.crypto.getRandomValues(arr);
    } else {
        for (let i = 0; i < 16; i++) arr[i] = Math.floor(Math.random() * 256);
    }
    return Array.from(arr, b => b.toString(16).padStart(2, "0")).join("");
}

function formatBytes(bytes) {
    const num = Number(bytes);
    if (!Number.isFinite(num) || num <= 0) return "0 B";
    const units = ["B", "KB", "MB", "GB"];
    const i = Math.min(Math.floor(Math.log(num) / Math.log(1024)), units.length - 1);
    return (num / Math.pow(1024, i)).toFixed(i === 0 ? 0 : 2) + " " + units[i];
}

function formatDate(ts) {
    try {
        return new Date(ts).toLocaleString("pt-BR");
    } catch {
        return "Data inválida";
    }
}

function validateURLInput(raw) {
    const trimmed = String(raw || "").trim();
    if (!trimmed) {
        return { valid: false, error: "Informe uma URL para análise." };
    }
    if (trimmed.length > 2048) {
        return { valid: false, error: "URL excede o limite de 2048 caracteres." };
    }
    if (/\s/.test(trimmed)) {
        return { valid: false, error: "A URL não pode conter espaços em branco." };
    }

    const withScheme = /^[a-zA-Z][a-zA-Z\d+\-.]*:\/\//.test(trimmed) ? trimmed : "http://" + trimmed;
    let parsed;
    try {
        parsed = new URL(withScheme);
    } catch {
        return { valid: false, error: "Formato de URL inválido. Ex: https://dominio.com" };
    }

    if (!["http:", "https:"].includes(parsed.protocol)) {
        return { valid: false, error: `Protocolo não suportado (${parsed.protocol}). Use HTTP ou HTTPS.` };
    }

    if (!parsed.hostname || (!parsed.hostname.includes(".") && parsed.hostname !== "localhost")) {
        return { valid: false, error: "Host inválido ou incompleto." };
    }

    return { valid: true, url: parsed };
}

function validateFileInput(file, maxMB) {
    if (!file || typeof file.name !== "string") {
        return { valid: false, error: "Objeto de arquivo inválido." };
    }
    const cleanName = file.name.trim();
    if (!cleanName) {
        return { valid: false, error: "Arquivo sem nome." };
    }
    const maxBytes = maxMB * 1024 * 1024;
    if (file.size > maxBytes) {
        return { valid: false, error: `Excede o limite configurado de ${maxMB} MB (${formatBytes(file.size)}).` };
    }
    return { valid: true };
}

/* =========================================================
   2. MOTOR CRIPTOGRÁFICO, HEURÍSTICO, FILTROS & EXPORTAÇÃO
========================================================= */
async function computeSHA512(buffer) {
    if (window.crypto && window.crypto.subtle) {
        const hashBuffer = await window.crypto.subtle.digest("SHA-512", buffer);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        return hashArray.map(b => b.toString(16).padStart(2, "0")).join("");
    }
    throw new Error("WebCrypto API indisponível neste navegador.");
}

function calculateShannonEntropy(uint8Array) {
    if (!uint8Array || uint8Array.length === 0) return 0;
    const freq = new Uint32Array(256);
    for (let i = 0; i < uint8Array.length; i++) {
        freq[uint8Array[i]]++;
    }
    let entropy = 0;
    const len = uint8Array.length;
    for (let i = 0; i < 256; i++) {
        if (freq[i] > 0) {
            const p = freq[i] / len;
            entropy -= p * Math.log2(p);
        }
    }
    return Number(entropy.toFixed(3));
}

function detectMagicSignature(bytes) {
    if (!bytes || bytes.length < 4) return "Desconhecido / Texto Curto";
    const hex = Array.from(bytes.slice(0, 4)).map(b => b.toString(16).padStart(2, "0").toUpperCase()).join(" ");
    if (bytes[0] === 0x4D && bytes[1] === 0x5A) return "Executável Windows (MZ/PE)";
    if (bytes[0] === 0x7F && bytes[1] === 0x45 && bytes[2] === 0x4C && bytes[3] === 0x46) return "Executável Linux (ELF)";
    if (bytes[0] === 0x50 && bytes[1] === 0x4B && bytes[2] === 0x03 && bytes[3] === 0x04) return "Arquivo Compactado / APK / JAR (ZIP)";
    if (bytes[0] === 0x25 && bytes[1] === 0x50 && bytes[2] === 0x44 && bytes[3] === 0x46) return "Documento PDF";
    return `Binário/Texto (${hex})`;
}

const HEURISTIC_RULES = [
    { name: "Captura de Senha em Formulário", score: 15, patterns: ['type="password"', "type='password'", 'name="senha"', 'name="passwd"'] },
    { name: "Envio Externo de Formulário", score: 18, patterns: ['action="http://', "action='http://", 'action="//'] },
    { name: "Interceptação de Teclado (Keylogger)", score: 20, patterns: ["keydown", "keypress", "document.onkeydown", "keyboardevent"] },
    { name: "Exfiltração / Coleta de Sessão (Stealer)", score: 22, patterns: ["document.cookie", "navigator.sendbeacon", "localstorage.getitem"] },
    { name: "Ofuscação Dinâmica de Código", score: 16, patterns: ["eval(", "atob(", "function(", "fromcharcode", "unescape("] },
    { name: "Execução PowerShell Suspeita", score: 25, patterns: ["powershell", "-encodedcommand", "invoke-expression", "iex ", "set-executionpolicy"] },
    { name: "Chamada de Shell / Processo", score: 18, patterns: ["/bin/sh", "/bin/bash", "cmd.exe", "child_process", "shell_execute"] },
    { name: "Persistência no Sistema", score: 20, patterns: ["currentversion\\run", "schtasks", "crontab", "autorun.inf"] }
];

const SUSPICIOUS_EXTENSIONS = [
    ".exe", ".scr", ".bat", ".cmd", ".ps1", ".vbs", ".vbe", ".js", ".jse", ".hta", ".msi", ".dll", ".jar", ".apk", ".com", ".pif", ".reg"
];

const SUSPICIOUS_TLDS = [".xyz", ".top", ".tk", ".ml", ".ga", ".cf", ".gq", ".work", ".click", ".zip", ".mov"];

function extractIOCs(text) {
    const iocs = new Set();
    const urlMatches = text.match(/https?:\/\/[^\s"'<>()]{4,120}/gi) || [];
    urlMatches.slice(0, 12).forEach(u => iocs.add(u));

    const ipMatches = text.match(/\b(?:\d{1,3}\.){3}\d{1,3}\b/g) || [];
    ipMatches.forEach(ip => {
        const parts = ip.split(".").map(Number);
        if (parts.every(n => n >= 0 && n <= 255)) {
            iocs.add("IP: " + ip);
        }
    });
    return Array.from(iocs).slice(0, 15);
}

function classifyRisk(score) {
    const n = Number(score);
    if (!Number.isFinite(n) || n < 25) return { level: "low", label: "BAIXO" };
    if (n < 50) return { level: "medium", label: "MÉDIO" };
    if (n < 75) return { level: "high", label: "ALTO" };
    return { level: "critical", label: "CRÍTICO" };
}

function filterReports(list, { query = "", risk = "all" } = {}) {
    const q = String(query).trim().toLowerCase();
    return (Array.isArray(list) ? list : []).filter(item => {
        if (risk !== "all" && item.riskLevel !== risk) return false;
        if (!q) return true;
        const nameMatch = String(item.name || "").toLowerCase().includes(q);
        const hashMatch = String(item.hash || "").toLowerCase().includes(q);
        const iocMatch = Array.isArray(item.iocs) && item.iocs.some(i => String(i).toLowerCase().includes(q));
        return nameMatch || hashMatch || iocMatch;
    });
}

function sortReports(list, sortBy = "new") {
    const copy = Array.isArray(list) ? [...list] : [];
    copy.sort((a, b) => {
        if (sortBy === "score") return (b.score ?? 0) - (a.score ?? 0);
        if (sortBy === "size") return (b.size ?? 0) - (a.size ?? 0);
        if (sortBy === "name") return String(a.name || "").localeCompare(String(b.name || ""));
        return (b.timestamp ?? 0) - (a.timestamp ?? 0);
    });
    return copy;
}

function buildJSONExport(data) {
    return JSON.stringify(Array.isArray(data) ? data : [], null, 2);
}

function buildCSVExport(data) {
    const list = Array.isArray(data) ? data : [];
    const header = ["Nome", "Origem", "Risco", "Score", "Tamanho_Bytes", "Entropia", "SHA512", "Data"];
    const escapeCell = v => `"${String(v ?? "").replace(/"/g, '""')}"`;

    const rows = list.map(r => [
        escapeCell(r.name),
        escapeCell(r.kind),
        escapeCell(r.riskLabel),
        escapeCell(r.score),
        escapeCell(r.size),
        escapeCell(r.entropy),
        escapeCell(r.hash),
        escapeCell(formatDate(r.timestamp))
    ].join(","));

    return [header.join(","), ...rows].join("\n");
}

async function analyzeFileBuffer({ name, size, buffer, isSynthetic = false }, config) {
    const bytes = new Uint8Array(buffer);
    const hash = await computeSHA512(buffer);
    const entropy = config.entropy ? calculateShannonEntropy(bytes) : 0;
    const magic = detectMagicSignature(bytes);

    let score = 0;
    const reasons = [];
    let iocs = [];

    const lowerName = name.toLowerCase();
    const ext = lowerName.includes(".") ? "." + lowerName.split(".").pop() : "";

    if (config.extension) {
        if (SUSPICIOUS_EXTENSIONS.includes(ext)) {
            score += 18;
            reasons.push(`Extensão executável ou de script detectada (${ext}).`);
        }
        if (/\.(pdf|doc|docx|jpg|png|txt)\.(exe|scr|bat|vbs|js|ps1)$/i.test(lowerName)) {
            score += 30;
            reasons.push("Técnica de dupla extensão detectada (mascaramento de arquivo).");
        }
        if (magic.includes("MZ/PE") && ![".exe", ".dll", ".scr", ".sys"].includes(ext)) {
            score += 28;
            reasons.push(`Divergência de cabeçalho: assinatura binária MZ/PE em arquivo "${ext || "sem extensão"}".`);
        }
    }

    if (config.entropy && bytes.length > 64) {
        if (entropy >= 7.5) {
            score += 22;
            reasons.push(`Entropia muito elevada (${entropy} bits/byte) — possível empacotamento ou criptografia.`);
        } else if (entropy >= 6.8) {
            score += 10;
            reasons.push(`Entropia moderada-alta (${entropy} bits/byte).`);
        }
    }

    const sampleBytes = bytes.slice(0, 512 * 1024);
    const textContent = new TextDecoder("utf-8", { fatal: false }).decode(sampleBytes);
    const lowerText = textContent.toLowerCase();

    if (config.ioc) {
        for (const rule of HEURISTIC_RULES) {
            const matched = rule.patterns.filter(p => lowerText.includes(p));
            if (matched.length > 0) {
                score += rule.score;
                reasons.push(`${rule.name} (padrões: ${matched.slice(0, 3).join(", ")}).`);
            }
        }
    }

    if (config.urls) {
        iocs = extractIOCs(textContent);
        if (iocs.length > 0) {
            score += Math.min(15, iocs.length * 3);
            reasons.push(`${iocs.length} indicador(es) de rede (URL/IP) embutido(s).`);
        }
    }

    score = Math.min(100, score);
    if (reasons.length === 0) {
        reasons.push("Nenhum indicador heurístico ou assinatura suspeita encontrada.");
    }

    const risk = classifyRisk(score);
    return {
        id: uuid(),
        kind: isSynthetic ? "AMOSTRA SINTÉTICA" : "ARQUIVO REAL",
        name,
        size,
        hash,
        entropy,
        magic,
        score,
        riskLevel: risk.level,
        riskLabel: risk.label,
        reasons,
        iocs,
        timestamp: Date.now()
    };
}

async function analyzeURLStatic(parsedUrl) {
    const fullStr = parsedUrl.href;
    const encoder = new TextEncoder();
    const hash = await computeSHA512(encoder.encode(fullStr).buffer);

    let score = 0;
    const reasons = [];
    const host = parsedUrl.hostname.toLowerCase();

    if (parsedUrl.protocol === "http:") {
        score += 18;
        reasons.push("Conexão sem criptografia TLS (HTTP puro).");
    }

    if (/^(?:\d{1,3}\.){3}\d{1,3}$/.test(host)) {
        score += 32;
        reasons.push("Host utiliza endereço IP direto em vez de domínio registrado.");
    }

    if (host.includes("xn--")) {
        score += 28;
        reasons.push("Domínio internacionalizado em Punycode (risco de ataque homográfico).");
    }

    if (parsedUrl.username || fullStr.includes("@")) {
        score += 30;
        reasons.push("Presença de '@' na URL (técnica clássica de ofuscação de destino).");
    }

    if (SUSPICIOUS_TLDS.some(tld => host.endsWith(tld))) {
        score += 20;
        reasons.push("TLD frequentemente associado a campanhas descartáveis de phishing.");
    }

    const subdomains = host.split(".").length - 2;
    if (subdomains >= 3) {
        score += 15;
        reasons.push(`Excesso de subdomínios encadeados (${subdomains} níveis).`);
    }

    const phishingKeywords = ["login", "verify", "secure", "account", "update", "bank", "pix", "senha", "auth"];
    const foundKw = phishingKeywords.filter(k => fullStr.toLowerCase().includes(k));
    if (foundKw.length >= 2) {
        score += 20;
        reasons.push(`Múltiplos termos sensíveis na estrutura da URL (${foundKw.join(", ")}).`);
    }

    score = Math.min(100, score);
    if (reasons.length === 0) {
        reasons.push("Estrutura lexical da URL dentro dos padrões normais.");
    }

    const risk = classifyRisk(score);
    return {
        id: uuid(),
        kind: "URL (ESTÁTICO)",
        name: fullStr,
        size: encoder.encode(fullStr).length,
        hash,
        entropy: calculateShannonEntropy(encoder.encode(fullStr)),
        magic: `Protocolo ${parsedUrl.protocol.replace(":", "").toUpperCase()}`,
        score,
        riskLevel: risk.level,
        riskLabel: risk.label,
        reasons,
        iocs: [host],
        timestamp: Date.now()
    };
}

