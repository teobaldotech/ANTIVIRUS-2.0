   7. MONETIZAÇÃO (ADMOB VALIDATOR, COOLDOWN & ANDROID BRIDGE)
========================================================= */
const MONETIZATION_STORAGE_KEY = "neonav-pro-ultra-v2-monetization";
const INTERSTITIAL_COOLDOWN_MS = 90 * 1000;

let monetizationConfig = {
    appId: "",
    bannerUnitId: "",
    interstitialUnitId: "",
    rewardedUnitId: "",
    nativeUnitId: "",
    stickyBannerEnabled: true,
    postScanInterstitial: false,
    lastInterstitialAt: 0,
    impressions: 0,
    rewardsEarned: 0
};

function validateAdMobIds({ appId = "", bannerUnitId = "", interstitialUnitId = "", rewardedUnitId = "", nativeUnitId = "" } = {}) {
    const appRegex = /^ca-app-pub-\d{16}~\d{10}$/;
    const unitRegex = /^ca-app-pub-\d{16}\/\d{10}$/;

    const cleanApp = String(appId).trim();
    const units = [
        { label: "Banner", value: String(bannerUnitId).trim() },
        { label: "Interstitial", value: String(interstitialUnitId).trim() },
        { label: "Rewarded", value: String(rewardedUnitId).trim() },
        { label: "Native Advanced", value: String(nativeUnitId).trim() }
    ];

    if (cleanApp && !appRegex.test(cleanApp)) {
        return { valid: false, error: "App ID inválido. Formato esperado: ca-app-pub-16dígitos~10dígitos." };
    }

    for (const u of units) {
        if (u.value && !unitRegex.test(u.value)) {
            return { valid: false, error: `${u.label} Unit ID inválido. Formato esperado: ca-app-pub-16dígitos/10dígitos.` };
        }
    }

    const configuredCount = units.filter(u => u.value.length > 0).length;
    return {
        valid: true,
        productionReady: Boolean(cleanApp) && configuredCount > 0,
        configuredCount
    };
}

function canTriggerInterstitial(nowMs = Date.now(), lastAtMs = monetizationConfig.lastInterstitialAt, forceManual = false) {
    if (forceManual) return true;
    return (nowMs - Number(lastAtMs || 0)) >= INTERSTITIAL_COOLDOWN_MS;
}

function hasAndroidAdBridge() {
    return Boolean(
        window.NeonAVBridge &&
        typeof window.NeonAVBridge.showInterstitial === "function" &&
        typeof window.NeonAVBridge.showRewarded === "function"
    );
}

function loadMonetizationConfig() {
    try {
        const raw = localStorage.getItem(MONETIZATION_STORAGE_KEY);
        if (!raw) return;
        const parsed = JSON.parse(raw);
        if (parsed && typeof parsed === "object") {
            monetizationConfig = {
                appId: String(parsed.appId || "").slice(0, 64),
                bannerUnitId: String(parsed.bannerUnitId || "").slice(0, 64),
                interstitialUnitId: String(parsed.interstitialUnitId || "").slice(0, 64),
                rewardedUnitId: String(parsed.rewardedUnitId || "").slice(0, 64),
                nativeUnitId: String(parsed.nativeUnitId || "").slice(0, 64),
                stickyBannerEnabled: parsed.stickyBannerEnabled !== false,
                postScanInterstitial: Boolean(parsed.postScanInterstitial),
                lastInterstitialAt: Number(parsed.lastInterstitialAt) || 0,
                impressions: Number(parsed.impressions) || 0,
                rewardsEarned: Number(parsed.rewardsEarned) || 0
            };
        }
    } catch {
        localStorage.removeItem(MONETIZATION_STORAGE_KEY);
    }
}

function saveMonetizationConfig() {
    try {
        localStorage.setItem(MONETIZATION_STORAGE_KEY, JSON.stringify(monetizationConfig));
    } catch {
        addLog("Aviso: não foi possível salvar configuração de monetização.", "warn");
    }
}

function renderMonetizationUI() {
    const isNative = hasAndroidAdBridge();
    const validation = validateAdMobIds(monetizationConfig);

    $("monetizationModeLabel").textContent = isNative
